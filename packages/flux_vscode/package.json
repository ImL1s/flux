{
    "name": "flux-vscode",
    "displayName": "Flux",
    "description": "Syntax highlighting, snippets, and language support for Flux - A dynamic scripting language for Flutter Server-Driven UI",
    "version": "0.2.0",
    "publisher": "ImL1s",
    "repository": {
        "type": "git",
        "url": "https://github.com/ImL1s/flux"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "keywords": [
        "flux",
        "flutter",
        "server-driven-ui",
        "scripting",
        "widget"
    ],
    "icon": "images/flux-icon.png",
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:flux"
    ],
    "contributes": {
        "languages": [
            {
                "id": "flux",
                "aliases": [
                    "Flux",
                    "flux"
                ],
                "extensions": [
                    ".flux"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "flux",
                "scopeName": "source.flux",
                "path": "./syntaxes/flux.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "flux",
                "path": "./snippets/flux.json"
            }
        ],
        "configuration": {
            "title": "Flux",
            "properties": {
                "flux.lspPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Flux LSP server executable. Leave empty to use the bundled server."
                },
                "flux.dapPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Flux DAP server executable. Leave empty to use the bundled server."
                },
                "flux.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Flux language server."
                }
            }
        },
        "debuggers": [
            {
                "type": "flux",
                "label": "Flux Debugger",
                "program": "./out/extension.js",
                "runtime": "node",
                "languages": [
                    "flux"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path to a text file.",
                                "default": "${workspaceFolder}/main.flux"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Automatically stop after launch.",
                                "default": true
                            },
                            "enableInlineCaching": {
                                "type": "boolean",
                                "description": "Enable inline caching optimization.",
                                "default": true
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "flux",
                        "request": "launch",
                        "name": "Run Flux Script",
                        "program": "${workspaceFolder}/main.flux",
                        "stopOnEntry": true
                    }
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "flux"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node ./out/test/runTest.js"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.75.0",
        "@vscode/test-electron": "^2.5.2",
        "glob": "^13.0.0",
        "mocha": "^11.7.5",
        "typescript": "^5.0.0"
    }
}